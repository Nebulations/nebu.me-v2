---
const { title, desc, preview, links } = Astro.props.data
---

<div class="project">
    <h1 class="title">{title}</h1>
    <p class="description">{desc}</p>
    <div class="preview-container">
        <img src=`/previews/${preview}` alt=`Preview of ${title}` draggable="false">
    </div>
    <div class="project-showcase">
        <div class="project-showcase-content">
            <div class="close-showcase">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" height="40px" width="40px" fill="rgb(235, 235, 235)"><path d="M10.47,31.47L8.53,29.53L18.06,20L8.53,10.47l1.94-1.94L20,18.06l9.53-9.53l1.94,1.94L21.94,20l9.53,9.53l-1.94,1.94L20,21.94l-9.53,9.53Z"/></svg>
            </div>
            <div class="inner-preview-container">
                <img src=`/previews/${preview}` alt=`Preview of ${title}` draggable="false">
            </div>
            <h1 class="title">{title}</h1>
            <p class="inner description">{desc}</p>
            <div class="links">
                {links.github && (
                    <a href={links.download} target="_blank" title="View source code">
                        <svg viewBox="0 0 24 24" height="32px" width="32px" aria-hidden="true">
                            <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z" />
                        </svg>
                    </a>
                )}
                {links.download && (
                    <a href={links.download} target="_blank" title="Download">
                        <svg xmlns="http://www.w3.org/2000/svg" height="32px" width="32px" viewBox="0 0 32 32" aria-hidden="true">
                            <path d="M14 3h4v12h5l-7 8-7-8h5z"/>
                            <path d="M5 26h22v3H5z"/>
                        </svg>
                    </a>
                )}
            </div>
            <div class="project-showcase-text">
                <slot />
            </div>
        </div>
    </div>
</div>

{/* Project styling */}
<style>
    .project {
        margin: 32px;
        padding: 12px;
        border-radius: 12px;
        background: rgb(30, 30, 30);
        border: 1px solid rgb(255, 255, 255, 0.1);

        height: 400px;
        min-width: 600px;

        transition: ease-in-out 0.2s;

        cursor: pointer;
    }

    .project:hover {
        border: 1px solid rgb(255, 255, 255, 0.3);
    }

    .title {
        font-size: 22pt;
        color: rgb(235, 235, 235);
        text-align: center;
        margin-top: 8px;
    }

    .preview-container {
        height: 80%;
        width: 100%;
        padding: 12px;
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;

        img {
            height: 100%;
            border-radius: 12px;
        }
    }

    .description {
        margin-top: 4px;
        font-size: 16pt;
        color: rgb(235, 235, 235);
        text-align: center;
    }
</style>

{/* Project showcase styling */}
<style>
    /* Shadow effect on the background */
    .project-showcase {
        display: none;

        position: fixed;
        z-index: 1;
        top: 0;
        left: 0;

        height: 100%;
        width: 100%;
        background: rgb(0, 0, 0, 0.6);

        flex-direction: column;
        align-items: center;
        overflow-y: auto;
    }

    .project-showcase.visible {
        display: flex;
        animation: fade-in 0.5s;
    }

    .project-showcase::before {
        content: "";
        flex: 1 1 0%;
        min-height: 120px;
    }

    .project-showcase::after {
        content: "";
        flex: 1 1 0%;
        min-height: 120px;
    }

    @keyframes fade-in {
        0% { opacity: 0; }
        100% { opacity: 1; }
    }

    .project-showcase-content {
        position: relative;
        width: 900px;
        max-width: calc(100% - 32px); /* Keeps it responsive on smaller screens */
        flex-shrink: 0; /* Prevents the modal from getting squished */

        border-radius: 12px;
        background: rgb(30, 30, 30);
        border: 1px solid rgb(255, 255, 255, 0.1);

        cursor: pointer;

        padding: 12px;
        box-sizing: border-box;
        margin-bottom: 120px;

        animation: slide-up 0.5s;
    }

    @keyframes slide-up {
        0% {
            transform: translateY(100%);
        }

        100% {
            transform: translateY(0%);
        }
    }

    .close-showcase {
        position: absolute;
        right: 0;
        margin-right: 10px;
        cursor: pointer;
        border-radius: 6px;
        border: 2px solid rgb(255, 255, 255, 0.1);
        transition: ease-in-out 0.2s;
    }

    .close-showcase:hover {
        cursor: pointer;
        background: rgb(25, 25, 25);
    }

    .close-showcase svg {
        display: flex;
    }

    .inner-preview-container {
        height: 200px;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;

        img {
            height: 100%;
            border-radius: 12px;
        }
    }

    .inner.description {
        margin-bottom: 16px;
        padding-bottom: 16px;
    }

    .links {
        height: 40px;
        width: 90%;
        margin: auto;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
    }

    .links svg {
        height: 32px;
        width: 32px;
        border-radius: 8px;
        border: 1px solid rgb(255, 255, 255, 0.1);
        fill: #fff;
        padding: 8px;
        transition: ease-in-out 0.2s;
    }

    .links svg:hover {
        background: rgb(25, 25, 25);
    }

    .project-showcase-text {
        margin: auto;
        width: 90%;
        color: rgb(235, 235, 235);

        h1,h2,h3 {
            border-bottom: 1px solid rgb(255, 255, 255, 0.1);
        }

        h1,h2,h3,h4,h5,h6 {
            margin-top: 16px;
            margin-bottom: 8px;
        }

        p, li {
            font-size: 14pt;
        }

        ul, ol {
            margin-left: 20px;
        }

        code {
            color: #ff7ac6;
            background: rgb(255, 122, 198, 0.1);
            border: 0;
            padding: 0.1em 0.4em;
            border-radius: 6px;
            font-size: 0.9em;
        }

        padding-bottom: 24px;
    }

    @media screen and (max-width: 640px) {
        .project {
            scale: 0.7;
            margin: 0px;
        }
    }
</style>

<script>
    document.querySelectorAll(".project").forEach((project) => {
        const preview = project.querySelector(".preview-container");
        const showcase = project.querySelector(".project-showcase");
        const closeBtn = project.querySelector(".close-showcase svg");

        preview?.addEventListener("click", () => {
            showcase?.classList.toggle("visible");
        });

        closeBtn?.addEventListener("click", () => {
            showcase?.classList.toggle("visible");
        });
    });
</script>
