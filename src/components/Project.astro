---
const { title, desc, preview } = Astro.props
---

<div class="project">
    <h1 class="title">{title}</h1>
    <p class="description">{desc}</p>
    <div class="preview-container">
        <img src=`/previews/${preview}` alt=`Preview of ${title}`>
    </div>
    <div class="project-showcase">
        <div class="project-showcase-content">
            <div class="close-showcase">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" height="40px" width="40px" fill="rgb(235, 235, 235)"><path d="M10.47,31.47L8.53,29.53L18.06,20L8.53,10.47l1.94-1.94L20,18.06l9.53-9.53l1.94,1.94L21.94,20l9.53,9.53l-1.94,1.94L20,21.94l-9.53,9.53Z"/></svg>
            </div>
            <h1 class="title">{title}</h1>
            <p class="inner description">{desc}</p>
            <div class="project-showcase-text">
                <slot />
            </div>
        </div>
    </div>
</div>

{/* Project styling */}
<style>
    .project {
        margin: 32px;
        padding: 12px;
        border-radius: 12px;
        background: rgb(30, 30, 30);
        border: 1px solid rgb(255, 255, 255, 0.1);

        height: 400px;
        width: 600px;
        
        transition: ease-in-out 0.2s;
        cursor: pointer;
    }

    .project:hover {
        border: 1px solid rgb(255, 255, 255, 0.3);
    }

    .title {
        font-size: 22pt;
        color: rgb(235, 235, 235);
        text-align: center;
        margin: 12px 12px 0px 12px;
    }

    .preview-container {
        height: 80%;
        width: 100%;
        padding: 12px;
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .preview-container img {
        height: 100%;
    }

    .description {
        margin-top: 4px;
        font-size: 16pt;
        color: rgb(235, 235, 235);
        text-align: center;
    }
</style>

{/* Project showcase styling */}
<style>
    .project-showcase {
        position: fixed;
        z-index: 1;
        top: 0;
        left: 0;

        height: 100%;
        width: 100%;
        background: rgb(0, 0, 0, 0.4);

        display: flex;
        justify-content: center;
        align-items: center;
    }

    .project-showcase-content {
        width: 900px;
        margin: auto;

        border-radius: 12px;
        background: rgb(30, 30, 30);
        border: 1px solid rgb(255, 255, 255, 0.1);

        padding: 12px;
        box-sizing: border-box;
    }

    .close-showcase {
        display: flex;
        justify-content: right;
        z-index: 5;
    }

    .close-showcase svg {
        display: flex;
    }

    .seperator {
        height: 10px;
        width: 100%;
        background-color: red;
    }

    .inner.description {
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgb(255, 255, 255, 0.1);
    }

    .project-showcase-text {
        color: rgb(235, 235, 235);
    }
</style>

<script>
    const project = document.getElementsByClassName("project")[0]
    const projectShowcase = document.getElementsByClassName("project-showcase")[0]

    project.addEventListener("click", () => {
        projectShowcase.classList.toggle("visible")
    })
</script>