---
const socials = [
    {
        alt: "GitHub",
        href: "https://github.com/Nebulations",
        src: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"></path></svg>',
        external: true
    },
    {
        alt: "Email",
        href: "mailto:contact@nebu.me",
        src: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5h20v14H2V5zm2.4 2L12 12.6 19.6 7H4.4zM4 9.1V17h16V9.1l-8 5.9-8-5.9z"></path></svg>',
        external: false
    }
]
---

<div class="socials">
    {socials.map(social => (
        <a
            class="social"
            href={social.href}
            aria-label={social.alt}
            target={social.external ? "_blank" : undefined}
            rel={social.external ? "noopener noreferrer" : undefined}
        >
            <Fragment set:html={social.src} />
        </a>
    ))}
</div>

<style>
    .socials {
        position: absolute;
        z-index: 1;
        left: 0;
        bottom: 0;
        margin: 32px;
        padding: 12px;
        border-radius: 12px;
        background: rgb(30, 30, 30);
        border: 1px solid rgb(255, 255, 255, 0.1);

        display: flex;
        justify-content: space-evenly;
        align-items: center;
        gap: 15px;
    }

    .social {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .social :global(svg) {
        height: 32px;
        width: 32px;
        fill: #fff;
    }
</style>