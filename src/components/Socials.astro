---
import githubIcon from '../assets/github.png'
import emailIcon from '../assets/email.png'

const socials = [
    {
        alt: "Github",
        href: "https://github.com/Nebulations",
        src: githubIcon.src
    },
    {
        alt: "Email",
        href: "mailto:contact@nebu.me",
        src: emailIcon.src
    }
]
---

<div class="socials">
    {socials.map(social => (
        <a class="social" href={social.href} target="_blank">
            <img src={social.src} alt={social.alt}>
        </a>
    ))}
</div>

<style>
    .socials {
        position: absolute;
        left: 0;
        bottom: 0;
        margin: 32px;
        padding: 12px;
        border-radius: 12px;
        background: rgb(30, 30, 30);
        border: 1px solid rgb(255, 255, 255, 0.1);

        display: flex;
        justify-content: space-evenly;
        align-items: center;
        gap: 15px;
    }

    .social {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .social img {
        height: 32px;
        width: 32px;
    }
</style>