---
import githubIcon from '../assets/github.png'
---

<div class="socials">
    <a class="social" href="https://github.com/Nebulations" target="_blank">
        <img src={githubIcon.src} height="32px" width="32px" alt="Github">
    </a>
</div>

<style>
    .socials {
        position: absolute;
        left: 0;
        bottom: 0;
        margin: 32px;
        padding: 12px;
        border-radius: 12px;
        background: rgb(30, 30, 30);
        border: 1px solid rgb(255, 255, 255, 0.1);

        display: flex;
        justify-content: space-evenly;
        align-items: center;
    }
</style>