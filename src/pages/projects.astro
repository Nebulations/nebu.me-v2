---
import Project from '../components/Project.astro';
import Layout from '../layouts/Layout.astro';

// Handling project loading
const projects = Object.values(import.meta.glob("../projects/*.md", { eager: true }))
---

<Layout tab="Projects">
	<div class="projects">
		{projects.map((project: any) => {

			if (!project.frontmatter.enabled) {
				return
			}

			return (
				<Project
					title={project.frontmatter.title}
					desc={project.frontmatter.desc}
					preview={project.frontmatter.preview}>
						<project.Content />
				</Project>
			)
		})}
	</div>
</Layout>

<style>
	.projects {
		width: 80%;

		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 2rem;
		margin: 40px auto;
	}
</style>
